# Lx-ui brand identity — the ONLY place to edit.
# After changing a value run:  tools/rebrand.sh   (idempotent; safe to re-run)
#
# LXUI_REPO: GitHub "<owner>/<repo>" that hosts Lx-ui releases, raw scripts and
# the self-update feed. "<ORG>" is a placeholder: replace it with the real
# GitHub user/organisation before publishing anything.
LXUI_REPO="jluo73423-ux/Lx-ui"
# Display name (UI titles, docs) and lowercase identifier (binary, service,
# paths, package names). Changing these after the first release is NOT
# recommended: runtime paths are derived from LXUI_NAME.
LXUI_DISPLAY="Lx-ui"
LXUI_NAME="lx-ui"
